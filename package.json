{
  "name": "diff-reviewer",
  "displayName": "Diff Reviewer",
  "description": "Review unstaged changes in the normal editor: approve (stage) or reject (discard) individual hunks",
  "version": "3.0.0",
  "publisher": "fredsvanelli",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/arneboe/diff-reviewer.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "icon": "images/icon.png",
  "keywords": [
    "diff",
    "review",
    "git",
    "hunk",
    "approve",
    "reject",
    "code review",
    "diff viewer",
    "staged changes"
  ],
  "categories": [
    "SCM Providers"
  ],
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "bugs": {
    "url": "https://github.com/arneboe/diff-reviewer/issues"
  },
  "qna": "https://github.com/arneboe/diff-reviewer/discussions",
  "activationEvents": [
    "workspaceContains:.git",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "diffReviewer",
          "title": "Diff Reviewer",
          "icon": "media/icons/diff-approval.svg"
        }
      ]
    },
    "views": {
      "diffReviewer": [
        {
          "id": "diffReviewer.fileTree",
          "name": "Unstaged Changes"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "diffReviewer.fileTree",
        "contents": "No git repositories found in the open folders.\nNested repositories are searched up to the depth set by `diffReviewer.repoScanDepth`.\n[Refresh](command:diffReviewer.refresh)",
        "when": "diffReviewer.noRepos"
      },
      {
        "view": "diffReviewer.fileTree",
        "contents": "All changes are staged and count as approved.\nCommit them, or run `git reset` to review them again.\n[Refresh](command:diffReviewer.refresh)",
        "when": "diffReviewer.allStaged"
      },
      {
        "view": "diffReviewer.fileTree",
        "contents": "No uncommitted changes.\n[Refresh](command:diffReviewer.refresh)",
        "when": "diffReviewer.clean"
      }
    ],
    "configuration": {
      "title": "Diff Reviewer",
      "properties": {
        "diffReviewer.repoScanDepth": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "description": "How many directory levels below a non-git workspace folder to search for nested git repositories."
        }
      }
    },
    "commands": [
      {
        "command": "diffReviewer.refresh",
        "title": "Refresh Diff",
        "icon": "$(refresh)",
        "category": "Diff Reviewer"
      },
      {
        "command": "diffReviewer.openFile",
        "title": "Open File for Review",
        "category": "Diff Reviewer"
      },
      {
        "command": "diffReviewer.undo",
        "title": "Undo Last Action",
        "icon": "$(discard)",
        "category": "Diff Reviewer"
      },
      {
        "command": "diffReviewer.approveFile",
        "title": "Approve File (stage)",
        "icon": "$(check)",
        "category": "Diff Reviewer"
      },
      {
        "command": "diffReviewer.rejectFile",
        "title": "Reject File (discard)",
        "icon": "$(close)",
        "category": "Diff Reviewer"
      },
      {
        "command": "diffReviewer.toggleReviewMode",
        "title": "Toggle Review Mode",
        "icon": "$(eye)",
        "category": "Diff Reviewer"
      },
      {
        "command": "diffReviewer.enableReviewMode",
        "title": "Enable Review Mode",
        "icon": "$(eye-closed)",
        "category": "Diff Reviewer"
      },
      {
        "command": "diffReviewer.disableReviewMode",
        "title": "Disable Review Mode",
        "icon": "$(eye)",
        "category": "Diff Reviewer"
      },
      {
        "command": "diffReviewer.approveHunk",
        "title": "Approve Hunk (stage)",
        "category": "Diff Reviewer"
      },
      {
        "command": "diffReviewer.rejectHunk",
        "title": "Reject Hunk (discard)",
        "category": "Diff Reviewer"
      },
      {
        "command": "diffReviewer.approveFileRef",
        "title": "Approve File (stage)",
        "category": "Diff Reviewer"
      },
      {
        "command": "diffReviewer.rejectFileRef",
        "title": "Reject File (discard)",
        "category": "Diff Reviewer"
      },
      {
        "command": "diffReviewer.approveHunkAtCursor",
        "title": "Approve Hunk at Cursor (stage)",
        "icon": "$(check)",
        "enablement": "diffReviewer.reviewMode",
        "category": "Diff Reviewer"
      },
      {
        "command": "diffReviewer.rejectHunkAtCursor",
        "title": "Reject Hunk at Cursor (discard)",
        "icon": "$(close)",
        "enablement": "diffReviewer.reviewMode",
        "category": "Diff Reviewer"
      },
      {
        "command": "diffReviewer.nextHunk",
        "title": "Go to Next Hunk",
        "icon": "$(arrow-down)",
        "enablement": "diffReviewer.reviewMode",
        "category": "Diff Reviewer"
      },
      {
        "command": "diffReviewer.previousHunk",
        "title": "Go to Previous Hunk",
        "icon": "$(arrow-up)",
        "enablement": "diffReviewer.reviewMode",
        "category": "Diff Reviewer"
      },
      {
        "command": "diffReviewer.approveActiveFile",
        "title": "Approve Active File (stage)",
        "enablement": "diffReviewer.reviewMode",
        "category": "Diff Reviewer"
      },
      {
        "command": "diffReviewer.rejectActiveFile",
        "title": "Reject Active File (discard)",
        "enablement": "diffReviewer.reviewMode",
        "category": "Diff Reviewer"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "diffReviewer.openFile",
          "when": "false"
        },
        {
          "command": "diffReviewer.approveFile",
          "when": "false"
        },
        {
          "command": "diffReviewer.rejectFile",
          "when": "false"
        },
        {
          "command": "diffReviewer.approveHunk",
          "when": "false"
        },
        {
          "command": "diffReviewer.rejectHunk",
          "when": "false"
        },
        {
          "command": "diffReviewer.approveFileRef",
          "when": "false"
        },
        {
          "command": "diffReviewer.rejectFileRef",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "diffReviewer.enableReviewMode",
          "when": "view == diffReviewer.fileTree && !diffReviewer.reviewMode",
          "group": "navigation@1"
        },
        {
          "command": "diffReviewer.disableReviewMode",
          "when": "view == diffReviewer.fileTree && diffReviewer.reviewMode",
          "group": "navigation@1"
        },
        {
          "command": "diffReviewer.refresh",
          "when": "view == diffReviewer.fileTree",
          "group": "navigation@2"
        },
        {
          "command": "diffReviewer.undo",
          "when": "view == diffReviewer.fileTree",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "diffReviewer.approveFile",
          "when": "view == diffReviewer.fileTree && viewItem == diffFile",
          "group": "inline@1"
        },
        {
          "command": "diffReviewer.rejectFile",
          "when": "view == diffReviewer.fileTree && viewItem == diffFile",
          "group": "inline@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "node --import tsx --test test/*.test.ts",
    "lint": "eslint . && tsc --noEmit",
    "lint:fix": "eslint . --fix",
    "ts:check": "tsc --noEmit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "esbuild": "^0.24.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.56.0"
  }
}
